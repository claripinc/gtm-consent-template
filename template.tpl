___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const getCookieValues = require('getCookieValues');
const setInWindow = require('setInWindow');
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeInteger = require('makeInteger');
const logToConsole = require('logToConsole');

const CDN_HOST = 'cdn.clarip.com';
const SIGNALS = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];

// 1. Default consent, before any other tag.
const defaultValue = data.defaultMode === 'opt_out' ? 'granted' : 'denied';
const defaults = {};
SIGNALS.forEach((signal) => {
  defaults[signal] = signal === 'security_storage' ? 'granted' : defaultValue;
});

const wait = makeInteger(data.waitForUpdate);
if (wait > 0) {
  defaults.wait_for_update = wait;
}
setDefaultConsentState(defaults);

// 2. Returning visitor: apply the saved choice from the clarip_gcm cookie.
const saved = getCookieValues('clarip_gcm')[0];
if (saved) {
  const update = {};
  let updateCount = 0;
  saved.split(',').forEach((pair) => {
    const parts = pair.split(':');
    const signal = parts[0];
    const value = parts[1];
    if (SIGNALS.indexOf(signal) !== -1 && (value === 'granted' || value === 'denied')) {
      update[signal] = value;
      updateCount++;
    }
  });
  if (updateCount > 0) {
    updateConsentState(update);
  }
}

// 3. Globals the Clarip script reads, same as the Integration Code.
setInWindow('claripGtmTemplate', true, true);
setInWindow('claripCdnHost', CDN_HOST, true);
setInWindow('claripClientName', data.clientName, true);
setInWindow('claripCookieConsentHost', data.clientName + '.clarip.com', true);
setInWindow('claripCookieManagerIdentifier', data.identifier, true);

// 4. Load the Clarip scripts in order.
const base = 'https://' + CDN_HOST + '/' + encodeUriComponent(data.clientName) + '/cookieconsent/assets/js/';

const fail = (file) => () => {
  logToConsole('Clarip: failed to load ' + file);
  data.gtmOnFailure();
};

const loadManager = () => {
  injectScript(base + 'clarip-cookie-manager.min.js', data.gtmOnSuccess, fail('clarip-cookie-manager.min.js'), 'clarip-cookie-manager');
};

const loadCookieConsent = () => {
  injectScript(base + 'cookieconsent.min.js', loadManager, fail('cookieconsent.min.js'), 'clarip-cookieconsent');
};

if (data.tcf) {
  injectScript(base + 'clarip-tcf-cmp.min.js', loadCookieConsent, fail('clarip-tcf-cmp.min.js'), 'clarip-tcf-cmp');
} else {
  loadCookieConsent();
}


